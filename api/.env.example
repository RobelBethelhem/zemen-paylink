# Local development secrets. Generated once — do not commit this file.
PAYLINK_ENV=development
PAYLINK_ADDR=:8080
PAYLINK_DATABASE=paylink:paylink@tcp(127.0.0.1:3306)/paylink

# Signs session tokens.
PAYLINK_JWT_SECRET=replace-with-48-random-characters
# Seals operator MPGS API passwords at rest (base64 of 32 bytes).
# Changing this makes every stored gateway credential unreadable.
PAYLINK_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes

# Where customers open pay links; also the gateway return URL.
PAYLINK_PUBLIC_BASE_URL=http://localhost:3000
PAYLINK_CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# Mastercard Payment Gateway defaults (operators may override per account).
PAYLINK_GATEWAY_HOST=test-gateway.mastercard.com
PAYLINK_GATEWAY_API_VERSION=100

# Optional SMTP for share-by-email and operator invites.
# PAYLINK_SMTP_HOST=
# PAYLINK_SMTP_PORT=587
# PAYLINK_SMTP_USERNAME=
# PAYLINK_SMTP_PASSWORD=
# PAYLINK_SMTP_FROM=paylink@zemenbank.et
