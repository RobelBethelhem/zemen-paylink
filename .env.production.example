# Copy to .env.production on the server and fill in. Never commit the filled copy.
#
#   cp .env.production.example .env.production && chmod 600 .env.production

# --- the domain Caddy gets a certificate for -------------------------------
# Must already point at this server's public IP before you start the stack.
API_DOMAIN=api.example.et

# --- database ---------------------------------------------------------------
# Used by both the db container and the API's DSN. Generate, do not invent.
#   openssl rand -base64 24
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- application ------------------------------------------------------------
PAYLINK_ENV=production

# Where customers open pay links, and where the gateway sends them back after
# paying. This is the FRONTEND address, not the API's.
PAYLINK_PUBLIC_BASE_URL=https://your-app.vercel.app
PAYLINK_CORS_ORIGINS=https://your-app.vercel.app

# The API sits behind Caddy on the compose network, so the forwarded header is
# believed from there and nowhere else. Get this wrong and every rate limit and
# lockout attributes to Caddy instead of the real caller.
# The proxies whose X-Forwarded-For is believed, and nothing else.
#
# The API walks the forwarded chain from the right, past every address named
# here, to the first one it did not put there — and calls that the client. A
# whole LAN range here means the clients inside it are walked past as well, and
# any of them can prepend an address and be attributed to it.
PAYLINK_TRUSTED_PROXIES=172.16.0.0/12,127.0.0.0/8

# Published through the bank reverse proxy. All four are empty for an
# internal-only deployment. See ONPREM.md.
#
#   PAYLINK_PUBLIC_SITE       the Host the proxy forwards, WITH the port
#   PAYLINK_PUBLIC_PATH_PREFIX the path it publishes under and strips
#   PAYLINK_EDGE_PROXIES       its address, so Caddy keeps the forwarded chain
#                              (add it to PAYLINK_TRUSTED_PROXIES too)
#   PAYLINK_BASE_PATH          build-time only, and only when the proxy keeps
#                              the prefix on the way through
PAYLINK_PUBLIC_SITE=
PAYLINK_PUBLIC_PATH_PREFIX=
PAYLINK_EDGE_PROXIES=
PAYLINK_BASE_PATH=
