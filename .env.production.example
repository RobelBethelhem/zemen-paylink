# Copy to .env.production on the server and fill in. Never commit the filled copy.
#
#   cp .env.production.example .env.production && chmod 600 .env.production

# --- the domain Caddy gets a certificate for -------------------------------
# Must already point at this server's public IP before you start the stack.
API_DOMAIN=api.example.et

# --- database ---------------------------------------------------------------
# Used by both the db container and the API's DSN. Generate, do not invent.
#   openssl rand -base64 24
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- application ------------------------------------------------------------
PAYLINK_ENV=production

# Where customers open pay links, and where the gateway sends them back after
# paying. This is the FRONTEND address, not the API's.
PAYLINK_PUBLIC_BASE_URL=https://your-app.vercel.app
PAYLINK_CORS_ORIGINS=https://your-app.vercel.app

# The API sits behind Caddy on the compose network, so the forwarded header is
# believed from there and nowhere else. Get this wrong and every rate limit and
# lockout attributes to Caddy instead of the real caller.
PAYLINK_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,127.0.0.0/8

# Signs session tokens. At least 32 characters.
#   openssl rand -base64 48
PAYLINK_JWT_SECRET=

# How long a session may last, and how long it may sit untouched. Both are
# checked on every request, and an account may hold only one session at a
# time — signing in elsewhere offers to end the first.
#
# TTL is absolute and is never extended: fifteen minutes after signing in, an
# operator signs in again however busy they have been. IDLE ends it sooner
# when nothing is done with it. Shorten either freely; lengthening them is a
# decision worth recording, because both are there to limit what an
# unattended screen is worth to somebody who finds it.
PAYLINK_SESSION_TTL=15m
PAYLINK_SESSION_IDLE=3m

# Seals operator MPGS API passwords at rest. Base64 of exactly 32 bytes.
#   openssl rand -base64 32
#
# CHANGING THIS AFTER GO-LIVE MAKES EVERY STORED GATEWAY CREDENTIAL
# UNREADABLE and every operator has to reconnect. Back it up somewhere the
# database backup is not.
PAYLINK_ENCRYPTION_KEY=

# First merchant-management sign-in. Change it after the first login.
# Without this the server generates one and prints it once at startup.
PAYLINK_BOOTSTRAP_PASSWORD=

# --- gateway ----------------------------------------------------------------
PAYLINK_GATEWAY_HOST=test-gateway.mastercard.com
PAYLINK_GATEWAY_API_VERSION=100
# Only if your acquirer issued a branded MPGS host that is not on mastercard.com.
# PAYLINK_GATEWAY_EXTRA_HOSTS=

# --- optional email ---------------------------------------------------------
# PAYLINK_SMTP_HOST=
# PAYLINK_SMTP_PORT=587
# PAYLINK_SMTP_USERNAME=
# PAYLINK_SMTP_PASSWORD=
# PAYLINK_SMTP_FROM=paylink@zemenbank.et
